{
  "$schema": "noddy-design-tokens/v1",
  "$description": "Single source of truth for Noddy design tokens. QML (desktop) and Compose (Android) themes are generated from this file. Bloom colors follow Material You tonal roles; at runtime the Android app derives them from the wallpaper and sends the seed to the PC (hello.device.accent). The palettes here are the fallbacks and brand presets.",
  "themes": {
    "ember": {
      "description": "Dark only. Near-black cards on black with one orange accent, a white pill for the selected item, large corner radii and a bento grid on Home. The look of the Ember theme.",
      "dynamicColor": false,
      "variants": {
        "dark": {
          "primary": "#EB6030",
          "onPrimary": "#2A0D00",
          "primaryContainer": "#5A2412",
          "onPrimaryContainer": "#FFDBCE",
          "secondaryContainer": "#2C2C30",
          "onSecondaryContainer": "#EDEDEF",
          "surface": "#0A0A0B",
          "surfaceContainerLow": "#0E0E0F",
          "surfaceContainer": "#141415",
          "surfaceContainerHigh": "#1B1B1D",
          "surfaceContainerHighest": "#242427",
          "onSurface": "#F4F4F5",
          "onSurfaceVariant": "#A1A1A6",
          "outline": "#6E6E74",
          "outlineVariant": "#2A2A2D",
          "warning": "#F2C14E",
          "error": "#FF8A7A",
          "onError": "#4A0A02"
        }
      },
      "shape": {
        "xs": 8,
        "sm": 12,
        "md": 16,
        "lg": 24,
        "xl": 32,
        "full": 999
      },
      "fonts": {
        "ui": "Figtree",
        "display": "Figtree",
        "label": "Figtree",
        "mono": "Space Mono"
      },
      "label": {
        "case": "none",
        "tracking": 0,
        "size": 12.5,
        "weight": 600
      },
      "indicator": {
        "color": "#F4F4F5",
        "content": "#111113"
      }
    },
    "glass": {
      "description": "Translucent near-black (or near-white) cards with one orange accent, large corner radii. The look of the Glass theme.",
      "dynamicColor": true,
      "defaultSeed": "orange",
      "seeds": {
        "orange": {
          "seed": "#E85C29",
          "light": {
            "primary": "#B23808",
            "onPrimary": "#FFFFFF",
            "primaryContainer": "#FFDBCE",
            "onPrimaryContainer": "#3A0F00",
            "secondaryContainer": "#E9E9EC",
            "onSecondaryContainer": "#1B1B1E",
            "surface": "#FAFAFA",
            "surfaceContainerLow": "#F4F4F5",
            "surfaceContainer": "#EEEEF0",
            "surfaceContainerHigh": "#E8E8EA",
            "surfaceContainerHighest": "#E2E2E5",
            "onSurface": "#18181B",
            "onSurfaceVariant": "#52525B",
            "outline": "#8A8A92",
            "outlineVariant": "#D4D4D8"
          },
          "dark": {
            "primary": "#EB6030",
            "onPrimary": "#2A0D00",
            "primaryContainer": "#5A2412",
            "onPrimaryContainer": "#FFDBCE",
            "secondaryContainer": "#2C2C30",
            "onSecondaryContainer": "#EDEDEF",
            "surface": "#0A0A0B",
            "surfaceContainerLow": "#0E0E0F",
            "surfaceContainer": "#141415",
            "surfaceContainerHigh": "#1B1B1D",
            "surfaceContainerHighest": "#242427",
            "onSurface": "#F4F4F5",
            "onSurfaceVariant": "#A1A1A6",
            "outline": "#6E6E74",
            "outlineVariant": "#2A2A2D"
          }
        }
      },
      "status": {
        "$note": "No green. Success / done / connected states use the theme's own color roles: primary (dot, 'On' chips) and primaryContainer/onPrimaryContainer (completed checks). Only warning and error have dedicated colors.",
        "light": {
          "success": "{primary}",
          "warning": "#7D5200",
          "error": "#BA1A1A",
          "onError": "#FFFFFF"
        },
        "dark": {
          "success": "{primary}",
          "warning": "#F2C14E",
          "error": "#FFB4AB",
          "onError": "#690005"
        }
      },
      "shape": {
        "xs": 8,
        "sm": 12,
        "md": 16,
        "lg": 24,
        "xl": 32,
        "full": 999
      },
      "fonts": {
        "ui": "Figtree",
        "display": "Figtree",
        "label": "Figtree",
        "mono": "Space Mono"
      },
      "label": {
        "case": "none",
        "tracking": 0,
        "size": 12.5,
        "weight": 600
      }
    }
  },
  "typography": {
    "displayLarge": {
      "size": 44,
      "lineHeight": 1.05,
      "weight": 650,
      "tracking": -0.025
    },
    "displaySmall": {
      "size": 30,
      "lineHeight": 1.1,
      "weight": 650,
      "tracking": -0.02
    },
    "headline": {
      "size": 22,
      "lineHeight": 1.2,
      "weight": 650,
      "tracking": -0.015
    },
    "title": {
      "size": 16,
      "lineHeight": 1.35,
      "weight": 600,
      "tracking": 0
    },
    "body": {
      "size": 14,
      "lineHeight": 1.5,
      "weight": 400,
      "tracking": 0
    },
    "bodySmall": {
      "size": 12.5,
      "lineHeight": 1.45,
      "weight": 400,
      "tracking": 0
    },
    "label": {
      "size": 12.5,
      "lineHeight": 1.3,
      "weight": 600,
      "tracking": 0
    },
    "caption": {
      "size": 11,
      "lineHeight": 1.3,
      "weight": 500,
      "tracking": 0
    },
    "code": {
      "size": 13,
      "lineHeight": 1.3,
      "weight": 700,
      "tracking": 0.14,
      "font": "mono"
    }
  },
  "spacing": {
    "unit": 4,
    "scale": [
      0,
      2,
      4,
      6,
      8,
      10,
      12,
      16,
      20,
      24,
      32,
      40,
      48,
      64
    ]
  },
  "layout": {
    "desktop": {
      "railWidth": 80,
      "topBarHeight": 52,
      "contentPadding": 22,
      "gutter": 16,
      "minWindow": [
        880,
        600
      ]
    },
    "phone": {
      "screenPadding": 16,
      "gutter": 10,
      "tabBarHeight": 64
    }
  },
  "elevation": {
    "bloom": {
      "level0": "none",
      "level1": "0 1px 2px rgba(0,0,0,.06)",
      "window": "0 1px 2px rgba(0,0,0,.06), 0 24px 60px -20px rgba(0,0,0,.18)"
    }
  },
  "motion": {
    "description": "Springs everywhere; durations are only for fades. Respect reduced-motion: replace movement with 120 ms fades.",
    "spring": {
      "gentle": {
        "stiffness": 220,
        "damping": 26,
        "use": "page and panel transitions"
      },
      "standard": {
        "stiffness": 380,
        "damping": 30,
        "use": "cards, sheets, expanding a notification into a conversation"
      },
      "snappy": {
        "stiffness": 620,
        "damping": 34,
        "use": "toggles, chips, buttons, hover lift"
      }
    },
    "fade": {
      "fast": 120,
      "normal": 200
    },
    "hoverLift": 2,
    "pressScale": 0.97
  },
  "icons": {
    "set": "Material Symbols Rounded (Apache-2.0)",
    "size": 20,
    "stroke": "outlined, 400 weight; filled when selected"
  }
}
